{
  "name": "rigwatch",
  "version": "2.1.0",
  "description": "Your whole machine on one page: CPU, GPU, temps, FPS, processes, ports, a Wazuh-style SIEM with a year of security history, network lab, Docker and dev servers. Zero dependencies, Windows / Linux / macOS.",
  "homepage": "https://firas44.github.io/RigWatch/",
  "repository": { "type": "git", "url": "https://github.com/firas44/RigWatch.git" },
  "main": "server.js",
  "bin": {
    "rigwatch": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "open": "node server.js --open",
    "test": "node --test test/",
    "build": "node scripts/build.js",
    "check": "node --test test/ && node scripts/build.js"
  },
  "files": [
    "server.js",
    "RigWatch.cmd",
    "dist/",
    "lib/",
    "public/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.15"
  },
  "keywords": [
    "system-monitor",
    "hardware-monitor",
    "task-manager",
    "dashboard",
    "gpu",
    "fps",
    "network",
    "netstat",
    "port-scanner",
    "security",
    "siem",
    "mitre-attack",
    "file-integrity-monitoring",
    "intrusion-detection",
    "docker",
    "devtools",
    "zero-dependency",
    "windows",
    "linux",
    "macos"
  ],
  "license": "MIT"
}
